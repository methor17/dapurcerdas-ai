# DapurCerdas AI v9 — edit sesuai perangkat Anda
# Google Search Engine ID dari script yang diberikan pengguna. ID ini boleh publik.
GOOGLE_CSE_ID=b0f250f042fc442b3

# ollama (default, gratis dan lokal), openai (API berbayar), catalog (tanpa model AI)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Untuk kualitas lebih tinggi bila komputer kuat: qwen3.5:9b atau qwen3.5:27b
AI_TIMEOUT_MS=95000
# 3000 token maksimum per resep, mengurangi waktu generate
OLLAMA_NUM_PREDICT=3000
OLLAMA_NUM_CTX=4096

# HANYA dipakai bila AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=3000

# v8.1: chat respons streaming (lebih cepat menampilkan token pertama)
OLLAMA_CHAT_NUM_PREDICT=450
CHAT_TIMEOUT_MS=65000
# Satu penyempurnaan singkat untuk 7-21 menu katalog yang sudah tersedia
PLAN_REFINE_TIMEOUT_MS=30000
